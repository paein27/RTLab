# Copia este archivo como `.env` y completa los valores. `.env` no se sube a git.

# Token de la API de NASA ADS (https://ui.adsabs.harvard.edu → Account → Settings → API Token).
# Se usa solo al compilar (`npm run build`) para traer las publicaciones de la biblioteca
# definida en src/data/site.json → ads.libraryId.
ADS_API_KEY=
