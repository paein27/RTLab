---
// src/layouts/DefaultLayout.astro
// Envuelve todas las páginas: <head>, Navbar y Footer.
// Props:
//   title       → título de la página (se antepone al nombre del grupo)
//   description → meta description (por defecto la de site.json)
//   fullWidth   → si es true, el contenido no se envuelve en un contenedor
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import site from "../data/site.json";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  fullWidth?: boolean;
}

const { title, description = site.description, fullWidth = false } =
  Astro.props;
const pageTitle = title
  ? `${title} · ${site.name} (${site.shortName})`
  : `${site.name} (${site.shortName}) · ${site.institution.university}`;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={site.logo.full} />
    <link rel="icon" type="image/png" href={site.logo.favicon} />
    <link rel="apple-touch-icon" href={site.logo.appleTouch} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <Navbar />
    {
      fullWidth ? (
        <main class="flex-grow">
          <slot />
        </main>
      ) : (
        <main class="flex-grow w-full max-w-7xl mx-auto px-4 py-10">
          <slot />
        </main>
      )
    }
    {
      Astro.slots.has("footer-cta") ? (
        <Footer>
          <slot name="footer-cta" />
        </Footer>
      ) : (
        <Footer />
      )
    }
  </body>
</html>
