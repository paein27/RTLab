---
// src/components/MemberCard.astro
import type { Member } from "../lib/team";
import { initials } from "../lib/team";

interface Props {
  member: Member;
  featured?: boolean;
}

const { member, featured = false } = Astro.props;
const { name, slug, position, education, area, img, bio, skills, hobbies, profiles, pending } = member;
const SHORT = featured ? 600 : 220;
const isLong = bio.length > SHORT;
const shortBio = isLong ? bio.slice(0, bio.lastIndexOf(" ", SHORT)) + "…" : bio;
---

<article
  id={slug}
  class:list={[
    "card scroll-mt-28 overflow-hidden h-full flex",
    featured ? "flex-col md:flex-row" : "flex-col",
  ]}
>
  <div
    class:list={[
      "relative bg-brand-100 shrink-0",
      featured ? "aspect-square md:w-80" : "aspect-square w-full",
    ]}
  >
    {
      img ? (
        <img
          src={img}
          alt={`Photo of ${name}`}
          class="w-full h-full object-cover"
          loading="lazy"
          width="600"
          height="600"
        />
      ) : (
        <div class="starfield w-full h-full flex items-center justify-center">
          <span class="font-display text-5xl font-bold text-white/90 tracking-wider">{initials(name)}</span>
        </div>
      )
    }
    {
      area && (
        <span class="absolute bottom-3 left-3 right-3 w-fit max-w-full truncate rounded-full bg-brand-900/85 px-3 py-1 text-xs font-medium text-white backdrop-blur">
          {area}
        </span>
      )
    }
  </div>

  <div class="p-5 flex-1 flex flex-col">
    <h3 class:list={["font-bold leading-tight", featured ? "text-2xl" : "text-lg"]}>{name}</h3>
    <p class="mt-1 text-sm font-semibold text-brand-600">{position}</p>
    {education && <p class="mt-1 text-xs text-gray-500">{education}</p>}

    {
      bio ? (
        <div class="mt-4 text-sm text-gray-700 leading-relaxed">
          <p data-bio-short>{shortBio}</p>
          {isLong && (
            <>
              <p data-bio-full class="hidden">{bio}</p>
              <button
                type="button"
                class="bio-toggle mt-2 text-sm font-semibold text-brand-600 hover:text-brand-800"
                aria-expanded="false"
              >
                Read more
              </button>
            </>
          )}
        </div>
      ) : (
        pending && <p class="mt-4 text-sm italic text-gray-400">Profile coming soon.</p>
      )
    }

    {
      skills && skills.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-1.5">
          {skills.map((s) => (
            <li class="rounded-full border border-brand-200 bg-brand-50 px-2.5 py-0.5 text-xs text-brand-800">{s}</li>
          ))}
        </ul>
      )
    }

    {
      hobbies && (
        <p class="mt-3 text-xs text-gray-500">
          <span class="font-semibold text-gray-600">Outside the lab:</span> {hobbies}
        </p>
      )
    }

    <div class="mt-auto pt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
      {
        profiles.orcid && (
          <a href={profiles.orcid} target="_blank" rel="noopener noreferrer" class="inline-flex items-center text-[#5a8a1c] hover:text-[#3f6313]" title="ORCID profile">
            <svg class="w-4 h-4 mr-1" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947 0 .525-.422.947-.947.947-.525 0-.946-.422-.946-.947 0-.525.421-.947.946-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.016-5.325 5.016h-3.919V7.416zm1.444 1.303v7.444h2.297c2.359 0 3.781-1.422 3.781-3.731 0-2.122-1.422-3.713-3.781-3.713h-2.297z" />
            </svg>
            ORCID
          </a>
        )
      }
      {
        profiles.linkedin && (
          <a href={profiles.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center text-brand-700 hover:text-brand-900" title="LinkedIn profile">
            <svg class="w-4 h-4 mr-1" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
            </svg>
            LinkedIn
          </a>
        )
      }
    </div>
  </div>
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>(".bio-toggle").forEach((btn) => {
    btn.addEventListener("click", () => {
      const wrap = btn.parentElement;
      const short = wrap?.querySelector("[data-bio-short]");
      const full = wrap?.querySelector("[data-bio-full]");
      if (!short || !full) return;
      const expanded = btn.getAttribute("aria-expanded") === "true";
      short.classList.toggle("hidden", !expanded);
      full.classList.toggle("hidden", expanded);
      btn.setAttribute("aria-expanded", String(!expanded));
      btn.textContent = expanded ? "Read more" : "Show less";
    });
  });
</script>
