---
// src/components/Footer.astro
// Si se le pasa contenido (slot), se muestra arriba del footer dentro del
// mismo fondo, como un único bloque (p. ej. la llamada a la acción de Home).
import site from "../data/site.json";
const year = new Date().getFullYear();
const hasCta = Astro.slots.has("default");
---

<footer class="starfield text-brand-100 mt-auto">
  {
    hasCta && (
      <div>
        <slot />
      </div>
    )
  }
  <div class="max-w-7xl mx-auto px-4 py-10 grid gap-8 md:grid-cols-3 items-start">
    <div>
      <img src={site.logo.white} alt={site.name} class="h-16 w-auto opacity-95" loading="lazy" />
      <p class="mt-3 text-sm text-brand-200 max-w-xs">{site.tagline}</p>
    </div>

    <div class="text-sm space-y-1">
      <p class="font-display font-semibold text-white">{site.institution.name}</p>
      <p>{site.institution.university}</p>
      <a href={site.institution.url} target="_blank" rel="noopener noreferrer" class="text-brand-300 hover:text-white">
        {site.institution.url.replace(/^https?:\/\//, "")}
      </a>
    </div>

    <div class="text-sm space-y-1 md:text-right">
      <p class="font-display font-semibold text-white">Contact</p>
      <a href={`mailto:${site.contactEmail}`} class="text-brand-300 hover:text-white">{site.contactEmail}</a>
    </div>
  </div>
  <div class="border-t border-white/10">
    <p class="max-w-7xl mx-auto px-4 py-4 text-xs text-brand-300">
      © {year} {site.name} ({site.shortName}) – {site.institution.university}.
    </p>
  </div>
</footer>
