---
// src/components/Navbar.astro
import site from "../data/site.json";

const links = [
  { href: "/", label: "Home" },
  { href: "/research", label: "Research" },
  { href: "/members", label: "Members" },
  { href: "/publications", label: "Publications" },
  { href: "/outreach", label: "Outreach" },
  { href: "/resources", label: "Resources" },
  { href: "/contact", label: "Contact" },
];

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? current === "/" : current.startsWith(href);
---

<header class="sticky top-0 z-40 bg-brand-900/95 backdrop-blur border-b border-white/10 shadow-sm">
  <nav class="relative max-w-7xl mx-auto flex items-center justify-between px-4 py-2">
    <a href="/" class="flex items-center shrink-0" aria-label={`${site.name} – Home`}>
      <img
        src={site.logo.white}
        alt={`${site.shortName} – ${site.name}`}
        class="h-14 md:h-16 w-auto"
        width="900"
        height="492"
      />
    </a>

    <button
      id="menu-toggle"
      class="lg:hidden p-2 rounded-md text-white hover:bg-white/10"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <svg id="icon-open" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg id="icon-close" class="h-7 w-7 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <ul
      id="nav-menu"
      class="hidden absolute top-full left-0 w-full flex-col gap-1 bg-brand-900 border-b border-white/10 p-4 shadow-lg lg:bg-transparent lg:shadow-none lg:border-0 lg:p-0 lg:static lg:w-auto lg:flex lg:flex-row lg:items-center lg:gap-1"
    >
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                "block px-3 py-2 rounded-md font-display text-sm font-semibold tracking-wide",
                isActive(link.href)
                  ? "text-white bg-white/15"
                  : "text-brand-100 hover:text-white hover:bg-white/10",
              ]}
              aria-current={isActive(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const btn = document.getElementById("menu-toggle");
  const menu = document.getElementById("nav-menu");
  const openIcon = document.getElementById("icon-open");
  const closeIcon = document.getElementById("icon-close");

  btn?.addEventListener("click", () => {
    const hidden = menu?.classList.toggle("hidden");
    openIcon?.classList.toggle("hidden");
    closeIcon?.classList.toggle("hidden");
    btn.setAttribute("aria-expanded", hidden ? "false" : "true");
  });
</script>
