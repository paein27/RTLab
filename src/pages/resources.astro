---
// src/pages/resources.astro
// Enlaces externos útiles. Cuando el grupo publique software o datos propios,
// agrégalos en `ownResources` (por ejemplo, repositorios de GitHub).
import DefaultLayout from "../layouts/DefaultLayout.astro";
import { libraryUrl } from "../lib/ads";

const ownResources: { name: string; url: string; text: string }[] = [
  { name: "Our ADS library", url: libraryUrl, text: "Every paper by the group, kept up to date on NASA ADS." },
];

const categories = [
  {
    title: "Transient & pulsar software",
    links: [
      { name: "PRESTO", url: "https://github.com/scottransom/presto", text: "Pulsar and single-pulse search and analysis" },
      { name: "PSRCHIVE", url: "https://psrchive.sourceforge.net", text: "Pulsar data analysis" },
      { name: "SIGPROC", url: "https://github.com/SixByNine/sigproc", text: "Pulsar search and filterbank tools" },
      { name: "your", url: "https://github.com/thepetabyteproject/your", text: "Python tools for radio transient data" },
      { name: "Astropy", url: "https://www.astropy.org", text: "Core astronomy library for Python" },
    ],
  },
  {
    title: "RF & digital instrumentation",
    links: [
      { name: "CASPER", url: "https://casper.berkeley.edu", text: "Open-source FPGA tools for radio astronomy" },
      { name: "RFSoC-PYNQ", url: "https://www.rfsoc-pynq.io", text: "Python framework for AMD RFSoC boards" },
      { name: "GNU Radio", url: "https://www.gnuradio.org", text: "Software-defined radio toolkit" },
      { name: "CASA", url: "https://casa.nrao.edu", text: "Radio interferometry data reduction" },
    ],
  },
  {
    title: "Catalogues & archives",
    links: [
      { name: "CHIME/FRB Catalog", url: "https://www.chime-frb.ca/catalog", text: "Catalogue of FRBs detected by CHIME" },
      { name: "FRBSTATS", url: "https://www.herta-experiment.org/frbstats/", text: "Statistics and catalogue of published FRBs" },
      { name: "ATNF Pulsar Catalogue", url: "https://www.atnf.csiro.au/research/pulsar/psrcat/", text: "Known radio pulsars" },
      { name: "ALMA Science Archive", url: "https://almascience.org/aq/", text: "ALMA observations" },
      { name: "NASA ADS", url: "https://ui.adsabs.harvard.edu", text: "Astrophysics literature search" },
    ],
  },
];
---

<DefaultLayout title="Resources">
  <header class="mb-10 max-w-3xl">
    <p class="eyebrow">Resources</p>
    <h1 class="mt-2 text-4xl md:text-5xl font-bold">Tools we use and recommend</h1>
    <p class="mt-4 text-lg text-gray-600 leading-relaxed">
      A short list of software, catalogues and archives that are useful for radio transient
      research and radio instrumentation.
    </p>
  </header>

  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-4">From the lab</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        ownResources.map((r) => (
          <a href={r.url} target="_blank" rel="noopener noreferrer" class="card p-5 group">
            <h3 class="font-bold group-hover:text-brand-600">{r.name} ↗</h3>
            <p class="mt-1 text-sm text-gray-600">{r.text}</p>
          </a>
        ))
      }
    </div>
  </section>

  {
    categories.map((c) => (
      <section class="mb-12">
        <h2 class="text-2xl font-bold mb-4">{c.title}</h2>
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {c.links.map((l) => (
            <li>
              <a href={l.url} target="_blank" rel="noopener noreferrer" class="card p-5 block h-full group">
                <h3 class="font-bold group-hover:text-brand-600">{l.name} ↗</h3>
                <p class="mt-1 text-sm text-gray-600">{l.text}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <section class="rounded-2xl starfield p-8 text-white">
    <h2 class="text-2xl font-bold !text-white">Students</h2>
    <p class="mt-2 text-brand-100 max-w-2xl">
      Interested in a research internship or thesis on radio transients, RF engineering or signal
      processing? Many of our members started as undergraduate interns.
    </p>
    <a href="/contact" class="btn-primary mt-6 !bg-white !text-brand-900 hover:!bg-brand-100">Get in touch</a>
  </section>
</DefaultLayout>
