---
// src/pages/index.astro
import DefaultLayout from "../layouts/DefaultLayout.astro";
import site from "../data/site.json";
import { team } from "../lib/team";

const lead = team.find((m) => m.group === "lead");
const featured = team.filter((m) => m.img && m.group !== "lead" && !m.pending).slice(0, 8);

// Las tres líneas de investigación del grupo (texto oficial del grupo).
const directions = [
  {
    title: "Astrophysics",
    text: "Seeking to understand what powers some of the fastest and most energetic events in the Universe by studying radio emission from pulsars and magnetars, as well as fast radio bursts (FRBs).",
    icon: "M13 10V3L4 14h7v7l9-11h-7z",
  },
  {
    title: "Data Science",
    text: "Combining observations from state-of-the-art radio telescopes with novel algorithms to detect and characterize transient radio signals.",
    icon: "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z",
  },
  {
    title: "Astroengineering and Aerospace",
    text: "Developing radio-frequency technologies for radio telescopes and satellite communications to make these systems more accessible, efficient, and sustainable.",
    icon: "M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0",
  },
];

const affiliations = [
  { name: site.institution.name, role: "Home of the lab" },
  { name: site.institution.university, role: "Host university" },
  { name: "Max Planck Institute for Radio Astronomy", role: "Max Planck Partner Group" },
];
---

<DefaultLayout fullWidth>
  <!-- Hero -->
  <section class="starfield text-white">
    <div class="max-w-7xl mx-auto px-4 py-20 md:py-28 grid gap-12 lg:grid-cols-2 items-center">
      <div>
        <p class="eyebrow !text-brand-300">{site.institution.name}</p>
        <h1 class="mt-4 text-4xl md:text-6xl font-extrabold !text-white leading-tight">
          Hey, World!
        </h1>
        <p class="mt-6 text-lg md:text-xl text-brand-100 leading-relaxed max-w-xl">
          We are the <strong class="text-white">Radio Transients LAB</strong>, an
          interdisciplinary team based at the Astroengineering Center UC (Chile), working at
          the finest timescales to unveil the mysteries of the dynamic Universe.
        </p>
        <div class="mt-10 flex flex-col sm:flex-row gap-4">
          <a href="/research" class="btn-primary !bg-white !text-brand-900 hover:!bg-brand-100">Explore our research</a>
          <a href="/publications" class="btn-secondary !bg-transparent !text-white !border-white/40 hover:!bg-white/10">
            Publications
          </a>
        </div>
      </div>
      <figure class="flex justify-center">
        <img
          src="/images/group/rtl-team.jpg"
          alt={`The ${site.name} team at the Astroengineering Center UC`}
          class="w-full max-w-xl rounded-2xl shadow-2xl ring-1 ring-white/20 object-cover"
          width="1280"
          height="810"
        />
      </figure>
    </div>
  </section>

  <!-- Three directions -->
  <section class="max-w-7xl mx-auto px-4 py-20">
    <div class="text-center mb-12">
      <p class="eyebrow">What we do</p>
      <h2 class="mt-2 section-title">Our research follows three directions</h2>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {
        directions.map((d) => (
          <div class="card p-6">
            <div class="w-11 h-11 rounded-lg bg-brand-900 flex items-center justify-center">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={d.icon} />
              </svg>
            </div>
            <h3 class="mt-4 text-lg font-bold">{d.title}</h3>
            <p class="mt-2 text-sm text-gray-600 leading-relaxed">{d.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- FRONTIERS -->
  <section class="bg-white border-b border-brand-100">
    <div class="max-w-7xl mx-auto px-4 py-16 grid gap-10 lg:grid-cols-5 items-center">
      <div class="lg:col-span-3">
        <p class="eyebrow">Flagship project</p>
        <h2 class="mt-2 section-title">FRONTIERS</h2>
        <p class="mt-4 text-lg text-gray-600 leading-relaxed">
          A compact array of 23 six-meter radio antennas to detect FRBs in the
          1–2 GHz band — a low-cost, large-N small-D radio telescope designed and
          built locally, that will also work as a satellite ground station.
        </p>
        <a href="/research" class="mt-6 inline-flex items-center font-semibold text-brand-600 hover:text-brand-800">
          Learn more
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>
      <div class="lg:col-span-2 space-y-4">
      <img
        src="/images/frontiers/frontiers-array.jpg"
        alt="FRONTIERS radio antennas"
        class="w-full rounded-xl object-cover shadow-md"
        width="1280"
        height="720"
        loading="lazy"
      />
      <dl class="grid grid-cols-2 gap-4">
        <div class="rounded-xl bg-brand-50 p-5"><dt class="text-xs uppercase tracking-wider text-brand-500">Antennas</dt><dd class="font-display text-3xl font-bold text-brand-900">23</dd></div>
        <div class="rounded-xl bg-brand-50 p-5"><dt class="text-xs uppercase tracking-wider text-brand-500">Dish</dt><dd class="font-display text-3xl font-bold text-brand-900">6 m</dd></div>
        <div class="rounded-xl bg-brand-50 p-5"><dt class="text-xs uppercase tracking-wider text-brand-500">Band</dt><dd class="font-display text-3xl font-bold text-brand-900">1–2 GHz</dd></div>
        <div class="rounded-xl bg-brand-50 p-5"><dt class="text-xs uppercase tracking-wider text-brand-500">Team</dt><dd class="font-display text-3xl font-bold text-brand-900">{team.length}</dd></div>
      </dl>
      </div>
    </div>
  </section>


  <!-- Team -->
  <section class="bg-white border-y border-brand-100">
    <div class="max-w-7xl mx-auto px-4 py-20">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
        <div>
          <p class="eyebrow">Our people</p>
          <h2 class="mt-2 section-title">Meet the team</h2>
          {lead && (
            <p class="mt-3 text-gray-600">
              Led by <a href={`/members#${lead.slug}`} class="font-semibold text-brand-700 hover:underline">{lead.name}</a>, {lead.position}.
            </p>
          )}
        </div>
        <a href="/members" class="btn-secondary">See all {team.length} members</a>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-4">
        {
          [lead, ...featured].filter(Boolean).map((m) => (
            <a href={`/members#${m!.slug}`} class="group text-center">
              <div class="aspect-square overflow-hidden rounded-full ring-2 ring-brand-100 group-hover:ring-brand-400 transition">
                <img src={m!.img} alt={m!.name} class="w-full h-full object-cover" loading="lazy" width="600" height="600" />
              </div>
              <p class="mt-2 text-sm font-semibold text-brand-900 leading-tight">{m!.name.split(" ").slice(0, 2).join(" ")}</p>
              <p class="text-xs text-gray-500 leading-tight">{m!.area}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Affiliations -->
  <section class="max-w-7xl mx-auto px-4 py-20">
    <div class="text-center mb-10">
      <p class="eyebrow">Affiliations</p>
      <h2 class="mt-2 section-title">Where we work</h2>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {
        affiliations.map((a) => (
          <div class="card p-6 text-center">
            <p class="font-display text-lg font-bold text-brand-900">{a.name}</p>
            <p class="mt-1 text-sm text-gray-500">{a.role}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- CTA: se dibuja dentro del footer para formar un solo bloque -->
  <section slot="footer-cta" class="text-white">
    <div class="max-w-4xl mx-auto px-4 py-16 text-center">
      <h2 class="text-3xl md:text-4xl font-bold !text-white">Want to work with us?</h2>
      <p class="mt-4 text-brand-100 text-lg">
        We welcome students and collaborators interested in radio astronomy, RF engineering and signal processing.
      </p>
      <a href="/contact" class="btn-primary mt-8 !bg-white !text-brand-900 hover:!bg-brand-100">Get in touch</a>
    </div>
  </section>
</DefaultLayout>
