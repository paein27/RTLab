---
// src/pages/contact.astro
import DefaultLayout from "../layouts/DefaultLayout.astro";
import site from "../data/site.json";
import { team } from "../lib/team";

const lead = team.find((m) => m.group === "lead");

const topics = [
  { title: "Research collaborations", text: "Joint projects, observing proposals and instrumentation partnerships.", subject: "Research collaboration" },
  { title: "Student opportunities", text: "Internships, theses and graduate positions.", subject: "Student opportunities", to: lead?.email },
  { title: "Outreach & media", text: "Talks, school visits, events and press enquiries.", subject: "Outreach / media" },
];
---

<DefaultLayout title="Contact">
  <header class="mb-12 max-w-3xl">
    <p class="eyebrow">Contact</p>
    <h1 class="mt-2 text-4xl md:text-5xl font-bold">Get in touch</h1>
    <p class="mt-4 text-lg text-gray-600 leading-relaxed">
      Collaborations, student opportunities or questions about our work — write to us.
    </p>
  </header>

  <div class="grid gap-8 lg:grid-cols-3 mb-14">
    <div class="card p-6 lg:col-span-1">
      <h2 class="text-lg font-bold">General enquiries</h2>
      <a href={`mailto:${site.contactEmail}`} class="mt-2 inline-block font-semibold text-brand-600 hover:underline break-all">
        {site.contactEmail}
      </a>
      {
        lead && (
          <div class="mt-6 pt-6 border-t border-brand-100">
            <h2 class="text-lg font-bold">Group leader</h2>
            <p class="mt-1 text-gray-800">{lead.name}</p>
            <p class="text-sm text-gray-500">{lead.position}</p>
            {lead.email && (
              <a href={`mailto:${lead.email}`} class="mt-2 inline-block font-semibold text-brand-600 hover:underline">
                {lead.email}
              </a>
            )}
          </div>
        )
      }
    </div>

    <div class="card p-6 lg:col-span-2">
      <h2 class="text-lg font-bold">Where we are</h2>
      <p class="mt-2 text-gray-800">{site.institution.name}</p>
      <p class="text-gray-600">{site.institution.university}</p>
      <p class="text-gray-600">Campus San Joaquín — Av. Vicuña Mackenna 4860, Macul, Santiago, Chile</p>
      <p class="mt-4 text-sm text-gray-500">
        Nearest metro: San Joaquín (Line 5). Please write to us in advance to arrange a visit.
      </p>
      <a
        href="https://www.google.com/maps/search/?api=1&query=Campus+San+Joaqu%C3%ADn+UC+Vicu%C3%B1a+Mackenna+4860"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-secondary mt-6"
      >
        Open in Google Maps
      </a>
    </div>
  </div>

  <section>
    <h2 class="text-2xl font-bold mb-6">What is your message about?</h2>
    <div class="grid gap-6 md:grid-cols-3">
      {
        topics.map((t) => (
          <a href={`mailto:${t.to ?? site.contactEmail}?subject=${encodeURIComponent(t.subject)}`} class="card p-6 group">
            <h3 class="text-lg font-bold group-hover:text-brand-600">{t.title}</h3>
            <p class="mt-2 text-sm text-gray-600">{t.text}</p>
            <span class="mt-4 inline-block text-sm font-semibold text-brand-600">Send an email →</span>
          </a>
        ))
      }
    </div>
  </section>
</DefaultLayout>
