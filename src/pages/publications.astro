---
// src/pages/publications.astro
// Las publicaciones se obtienen de NASA ADS al compilar (ver src/lib/ads.ts).
import DefaultLayout from "../layouts/DefaultLayout.astro";
import { getPublications, libraryUrl, type Publication } from "../lib/ads";
import { matchMember } from "../lib/team";
import site from "../data/site.json";

const { status, source, publications, fetchedAt } = await getPublications();

const MAX_AUTHORS = 8;

/** Lista de autores con los miembros del grupo resaltados y enlazados. */
function authorList(pub: Publication) {
  const items = pub.authors.map((name, i) => ({ name, i, member: matchMember(name) }));
  if (items.length <= MAX_AUTHORS + 2) return { shown: items, hidden: 0 };
  const head = items.slice(0, MAX_AUTHORS);
  const extraMembers = items.slice(MAX_AUTHORS).filter((a) => a.member);
  return { shown: [...head, ...extraMembers], hidden: items.length - head.length - extraMembers.length };
}

const byYear = new Map<string, Publication[]>();
for (const p of publications) {
  const key = p.year ? String(p.year) : "Other";
  byYear.set(key, [...(byYear.get(key) ?? []), p]);
}
const years = [...byYear.keys()];
const totalCitations = publications.reduce((n, p) => n + p.citations, 0);
const updated = new Date(fetchedAt).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---

<DefaultLayout title="Publications">
  <header class="mb-10">
    <p class="eyebrow">Research output</p>
    <h1 class="mt-2 text-4xl md:text-5xl font-bold">Publications</h1>
    <p class="mt-4 text-lg text-gray-600 max-w-3xl leading-relaxed">
      Papers by {site.name} members{source === "ads" ? ", synchronised automatically" : ""} from our
      <a href={libraryUrl} target="_blank" rel="noopener noreferrer" class="font-semibold text-brand-600 hover:underline">
        NASA ADS library</a>. Group members are highlighted in the author lists.
    </p>
  </header>

  {
    status !== "ok" ? (
      <div class="card p-8 text-center max-w-2xl mx-auto">
        <svg class="w-10 h-10 mx-auto text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
        <h2 class="mt-4 text-xl font-bold">Our publication list lives on NASA ADS</h2>
        <p class="mt-2 text-gray-600">
          The list could not be loaded right now. You can browse all of our papers directly in our public ADS library.
        </p>
        <a href={libraryUrl} target="_blank" rel="noopener noreferrer" class="btn-primary mt-6">
          Open the library on ADS
        </a>
      </div>
    ) : (
      <>
        <div class="mb-8 flex flex-col md:flex-row md:items-center gap-4 justify-between">
          <div class="flex flex-wrap gap-3 text-sm">
            <span class="rounded-lg bg-white border border-brand-100 px-3 py-2">
              <strong class="font-display text-brand-900">{publications.length}</strong> papers
            </span>
            <span class="rounded-lg bg-white border border-brand-100 px-3 py-2">
              <strong class="font-display text-brand-900">{totalCitations}</strong> citations
            </span>
            <span class="rounded-lg bg-white border border-brand-100 px-3 py-2 text-gray-500">Updated {updated}</span>
          </div>
          <div class="flex flex-col sm:flex-row gap-3">
            <input
              id="pub-search"
              type="search"
              placeholder="Search title, author, keyword…"
              class="w-full sm:w-72 rounded-lg border border-brand-200 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-400"
            />
            <select
              id="pub-year"
              class="rounded-lg border border-brand-200 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-400"
              aria-label="Filter by year"
            >
              <option value="">All years</option>
              {years.map((y) => <option value={y}>{y}</option>)}
            </select>
          </div>
        </div>

        <p id="pub-empty" class="hidden text-center text-gray-500 py-10">No publications match your search.</p>

        {years.map((year) => (
          <section class="pub-year mb-10" data-year={year}>
            <h2 class="mb-4 flex items-center gap-4 text-2xl font-bold">
              {year}
              <span class="h-px flex-1 bg-brand-200" />
            </h2>
            <div class="space-y-4">
              {byYear.get(year)!.map((pub) => {
                const { shown, hidden } = authorList(pub);
                const searchText = [pub.title, pub.authors.join(" "), pub.journal, pub.keywords.join(" ")].join(" ").toLowerCase();
                return (
                  <article class="pub card p-5 md:p-6" data-search={searchText}>
                    <div class="flex items-start justify-between gap-4">
                      <h3 class="text-lg font-semibold leading-snug">
                        <a href={pub.adsUrl} target="_blank" rel="noopener noreferrer" class="hover:text-brand-600">
                          {pub.title}
                        </a>
                      </h3>
                      {pub.citations > 0 && (
                        <span class="shrink-0 rounded-full bg-brand-50 border border-brand-200 px-2.5 py-0.5 text-xs font-semibold text-brand-700" title="Citations (ADS)">
                          {pub.citations} cit.
                        </span>
                      )}
                    </div>

                    <p class="mt-2 text-sm text-gray-700 leading-relaxed">
                      {shown.map((a, idx) => (
                        <>
                          {idx > 0 && (a.i - shown[idx - 1].i > 1 ? " … " : ", ")}
                          {a.member ? (
                            <a href={`/members#${a.member.slug}`} class="font-semibold text-brand-700 underline decoration-brand-300 underline-offset-2 hover:text-brand-900">
                              {a.name}
                            </a>
                          ) : (
                            <span>{a.name}</span>
                          )}
                        </>
                      ))}
                      {hidden > 0 && <span class="text-gray-500 italic"> and {hidden} more</span>}
                    </p>

                    <p class="mt-2 text-sm text-gray-500">
                      <span class="italic">{pub.journal}</span>
                      {pub.date && <> · {pub.date}</>}
                      {pub.refereed && <span class="ml-2 rounded bg-emerald-50 px-1.5 py-0.5 text-xs font-medium text-emerald-700">Refereed</span>}
                    </p>

                    {pub.abstract && (
                      <details class="mt-3 group">
                        <summary class="cursor-pointer select-none text-sm font-semibold text-brand-600 hover:text-brand-800">
                          Abstract
                        </summary>
                        <p class="mt-2 text-sm text-gray-700 leading-relaxed">{pub.abstract}</p>
                        {pub.keywords.length > 0 && (
                          <ul class="mt-3 flex flex-wrap gap-1.5">
                            {pub.keywords.slice(0, 8).map((k) => (
                              <li class="rounded-full bg-brand-50 px-2 py-0.5 text-xs text-brand-800">{k}</li>
                            ))}
                          </ul>
                        )}
                      </details>
                    )}

                    <div class="mt-4 flex flex-wrap gap-2 text-xs font-semibold">
                      <a href={pub.adsUrl} target="_blank" rel="noopener noreferrer" class="rounded-md border border-brand-200 px-3 py-1.5 text-brand-700 hover:bg-brand-50">
                        ADS
                      </a>
                      {pub.doi && (
                        <a href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener noreferrer" class="rounded-md border border-gray-200 px-3 py-1.5 text-gray-700 hover:bg-gray-50">
                          DOI
                        </a>
                      )}
                      {pub.arxiv && (
                        <a href={`https://arxiv.org/abs/${pub.arxiv}`} target="_blank" rel="noopener noreferrer" class="rounded-md border border-red-200 px-3 py-1.5 text-red-700 hover:bg-red-50">
                          arXiv:{pub.arxiv}
                        </a>
                      )}
                    </div>
                  </article>
                );
              })}
            </div>
          </section>
        ))}
      </>
    )
  }
</DefaultLayout>

<script>
  const search = document.getElementById("pub-search") as HTMLInputElement | null;
  const yearSel = document.getElementById("pub-year") as HTMLSelectElement | null;
  const empty = document.getElementById("pub-empty");

  function applyFilters() {
    const q = (search?.value ?? "").trim().toLowerCase();
    const year = yearSel?.value ?? "";
    let visible = 0;
    document.querySelectorAll<HTMLElement>(".pub-year").forEach((section) => {
      const yearOk = !year || section.dataset.year === year;
      let count = 0;
      section.querySelectorAll<HTMLElement>(".pub").forEach((pub) => {
        const show = yearOk && (!q || (pub.dataset.search ?? "").includes(q));
        pub.classList.toggle("hidden", !show);
        if (show) count++;
      });
      section.classList.toggle("hidden", count === 0);
      visible += count;
    });
    empty?.classList.toggle("hidden", visible > 0);
  }

  search?.addEventListener("input", applyFilters);
  yearSel?.addEventListener("change", applyFilters);
</script>
