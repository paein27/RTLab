---
// src/pages/outreach.astro
// Agrega actividades reales en `highlights` (charlas, ferias, prensa, etc.).
import DefaultLayout from "../layouts/DefaultLayout.astro";
import site from "../data/site.json";

const highlights = [
  {
    title: "SPIE Astronomical Telescopes + Instrumentation 2026",
    meta: "Copenhagen, Denmark",
    text: "Our team presented the mechanical design of the FRONTIERS GFRP reflector, with an accompanying proceedings paper.",
  },
  {
    title: "Women in STEM",
    meta: "Ongoing",
    text: "Members of the lab are active in science outreach and in advocating for women in STEM.",
  },
  {
    title: "Training the next generation of instrument builders",
    meta: "Ongoing",
    text: "Undergraduate engineering students join FRONTIERS as research interns, gaining hands-on experience in antennas, RF, signal processing and energy systems.",
  },
];

const offers = [
  { title: "School & university talks", text: "Radio astronomy, Fast Radio Bursts and how we build radio telescopes in Chile." },
  { title: "Lab visits", text: "Small-group visits to see our antennas, RF and digital hardware up close." },
  { title: "Student internships", text: "Research internships for engineering, physics and astronomy students." },
];
---

<DefaultLayout title="Outreach">
  <header class="mb-12 max-w-3xl">
    <p class="eyebrow">Outreach</p>
    <h1 class="mt-2 text-4xl md:text-5xl font-bold">Science belongs to everyone</h1>
    <p class="mt-4 text-lg text-gray-600 leading-relaxed">
      At {site.shortName} we like to share what we do: the physics of radio transients and the
      engineering behind the instruments that detect them. We are especially committed to bringing
      radio astronomy instrumentation closer to students in Chile and Latin America.
    </p>
  </header>

  <section class="mb-14">
    <h2 class="text-2xl font-bold mb-6">Highlights</h2>
    <ol class="relative border-l-2 border-brand-200 ml-2 space-y-8">
      {
        highlights.map((h) => (
          <li class="pl-6 relative">
            <span class="absolute -left-[9px] top-1.5 h-4 w-4 rounded-full bg-brand-600 ring-4 ring-brand-50" />
            <p class="text-xs font-semibold uppercase tracking-wider text-brand-500">{h.meta}</p>
            <h3 class="mt-1 text-lg font-bold">{h.title}</h3>
            <p class="mt-1 text-gray-600 max-w-2xl">{h.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mb-14">
    <h2 class="text-2xl font-bold mb-6">What we can offer</h2>
    <div class="grid gap-6 md:grid-cols-3">
      {
        offers.map((o) => (
          <div class="card p-6">
            <h3 class="text-lg font-bold">{o.title}</h3>
            <p class="mt-2 text-sm text-gray-600 leading-relaxed">{o.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="rounded-2xl starfield p-8 text-white text-center">
    <h2 class="text-2xl font-bold !text-white">Invite us</h2>
    <p class="mt-2 text-brand-100 max-w-2xl mx-auto">
      Organising a talk, a school visit or a science event? We would love to hear from you.
    </p>
    <a href="/contact" class="btn-primary mt-6 !bg-white !text-brand-900 hover:!bg-brand-100">
      Write to us
    </a>
  </section>
</DefaultLayout>
