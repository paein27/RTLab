---
// src/pages/research.astro
import DefaultLayout from "../layouts/DefaultLayout.astro";
import site from "../data/site.json";

const teams = [
  {
    title: "Antenna (Mechanical) Design",
    text: "GFRP reflector with an embedded aluminum mesh, modular dish joints, feed supports and the antenna mount — modelled in CAD, validated with finite-element analysis and designed to be manufactured locally.",
  },
  {
    title: "Antenna (RF) Design",
    text: "L-band (1–2 GHz) feeds, RF front-ends and complete RF chains, plus experimental manufacturing of RF components by 3D printing and copper electroplating.",
  },
  {
    title: "Digital Signal Processing",
    text: "FPGA / RFSoC backends that sample at 5 GS/s, channelise the band and search for dispersed bursts; SDR systems and spectrum surveys from 500 MHz to 18 GHz for site selection.",
  },
  {
    title: "Energy Modelling",
    text: "Off-grid photovoltaic and LFP battery systems, thermal design of enclosures and reliability studies so the antennas can keep observing at remote sites.",
  },
];

const science = [
  {
    title: "Fast Radio Bursts",
    text: "Millisecond radio flashes from distant galaxies. We work on targeted searches for repeating FRBs, FRB simulations, and on the instruments and backends needed to detect them in real time.",
  },
  {
    title: "Magnetars & pulsars",
    text: "Magnetars are leading FRB progenitor candidates. Using Phased ALMA we detected pulses from the Galactic Centre magnetar at millimetre wavelengths, and we study the polarization of magnetars near the Galactic Centre.",
  },
  {
    title: "Machine learning for transients",
    text: "Deep-learning pipelines for the automatic detection and classification of radio transients in large data streams, separating genuine signals from radio-frequency interference.",
  },
  {
    title: "Resource-aware RF technology",
    text: "Low-cost RF and digital technology for radio astronomy that can also serve satellite communications — including turning FRONTIERS into a dual-use instrument with an X-band ground-station link.",
  },
];
---

<DefaultLayout title="Research">
  <header class="mb-10 max-w-3xl">
    <p class="eyebrow">Research</p>
    <h1 class="mt-2 text-4xl md:text-5xl font-bold">From the sky to the signal chain</h1>
    <p class="mt-4 text-lg text-gray-600 leading-relaxed">
      {site.name} studies radio transients — Fast Radio Bursts, pulsars and magnetars — and
      builds the instrumentation to detect them. Our work combines observational radio astronomy,
      RF and antenna engineering, digital signal processing and data science.
    </p>
  </header>

  <!-- FRONTIERS -->
  <section class="mb-14 overflow-hidden rounded-2xl starfield text-white">
    <img
      src="/images/frontiers/frontiers-array.jpg"
      alt="FRONTIERS radio antennas"
      class="w-full h-56 md:h-80 object-cover"
      width="1280"
      height="720"
    />
    <div class="p-8 md:p-10 grid gap-8 lg:grid-cols-5">
      <div class="lg:col-span-3">
        <p class="eyebrow !text-brand-300">Flagship instrument</p>
        <h2 class="mt-2 text-3xl font-bold !text-white">FRONTIERS</h2>
        <p class="mt-4 text-brand-100 leading-relaxed">
          FRONTIERS is the project that invites us to rethink how we build and operate radio
          telescopes. We are designing an array in Chile to continuously monitor radio transients,
          with sustainability incorporated from the beginning: reducing cost, complexity, and
          energy consumption without sacrificing the sensitivity required for the science.
        </p>
        <p class="mt-4 text-brand-100 leading-relaxed">
          To achieve this, we are developing a modular Large-N, Small-D phased array of 25 6m
          dishes operating at centimetric-waves. Its room-temperature receivers, reconfigurable
          digital backend, and real-time processing pipeline are being designed with energy
          efficiency in mind, allowing the telescope to operate on photovoltaic power. The modular
          design also allows us to expand the array as resources become available.
        </p>
        <p class="mt-4 text-brand-100 leading-relaxed">
          FRONTIERS is a collaboration between UC Chile, the Max Planck Institute for Radio
          Astronomy, and ANID CPS-RTC Technological Center. We are currently validating the core
          technologies that will make this approach possible, laying the groundwork for the future
          expansion of the array.
        </p>
      </div>
      <dl class="lg:col-span-2 grid grid-cols-2 gap-4 self-center">
        <div class="rounded-xl bg-white/10 p-4"><dt class="text-xs uppercase tracking-wider text-brand-300">Antennas</dt><dd class="font-display text-3xl font-bold">25</dd></div>
        <div class="rounded-xl bg-white/10 p-4"><dt class="text-xs uppercase tracking-wider text-brand-300">Dish size</dt><dd class="font-display text-3xl font-bold">6 m</dd></div>
        <div class="rounded-xl bg-white/10 p-4"><dt class="text-xs uppercase tracking-wider text-brand-300">Band</dt><dd class="font-display text-3xl font-bold">1–2 GHz</dd></div>
        <div class="rounded-xl bg-white/10 p-4"><dt class="text-xs uppercase tracking-wider text-brand-300">Sampling</dt><dd class="font-display text-3xl font-bold">5 GS/s</dd></div>
      </dl>
    </div>
  </section>

  <!-- Teams -->
  <section class="mb-14">
    <h2 class="text-2xl font-bold mb-2">Engineering teams</h2>
    <p class="mb-6 text-gray-600">FRONTIERS is built by four teams working side by side.</p>
    <div class="grid gap-6 sm:grid-cols-2">
      {
        teams.map((t) => (
          <div class="card p-6">
            <h3 class="text-lg font-bold">{t.title}</h3>
            <p class="mt-2 text-sm text-gray-600 leading-relaxed">{t.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Science -->
  <section class="mb-14">
    <h2 class="text-2xl font-bold mb-2">Science</h2>
    <p class="mb-6 text-gray-600">The questions that drive the instruments.</p>
    <div class="grid gap-6 sm:grid-cols-2">
      {
        science.map((s) => (
          <div class="card p-6 border-l-4 !border-l-brand-600">
            <h3 class="text-lg font-bold">{s.title}</h3>
            <p class="mt-2 text-sm text-gray-600 leading-relaxed">{s.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Partners -->
  <section class="mb-6 rounded-2xl bg-white border border-brand-100 p-8">
    <h2 class="text-2xl font-bold mb-6">Partners & facilities</h2>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      <div>
        <h3 class="font-bold">{site.institution.name}</h3>
        <p class="mt-1 text-sm text-gray-600">Home of the lab, at {site.institution.university}.</p>
      </div>
      <div>
        <h3 class="font-bold">Max Planck Institute for Radio Astronomy</h3>
        <p class="mt-1 text-sm text-gray-600">RTL is a Max Planck Partner Group with the MPIfR (Bonn, Germany).</p>
      </div>
      <div>
        <h3 class="font-bold">ANID CPS-RTC Technological Center</h3>
        <p class="mt-1 text-sm text-gray-600">Partner in the development of FRONTIERS.</p>
      </div>
      <div>
        <h3 class="font-bold">ALMA</h3>
        <p class="mt-1 text-sm text-gray-600">Phased-array observations of radio transients at millimetre wavelengths.</p>
      </div>
    </div>
    <p class="mt-8 text-sm text-gray-600">
      See our <a href="/publications" class="font-semibold text-brand-600 hover:underline">publications</a> for the results of this work.
    </p>
  </section>
</DefaultLayout>
